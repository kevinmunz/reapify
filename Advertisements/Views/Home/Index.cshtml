@{
    ViewData["Title"] = "Overview";
}

<header class="py-5 mb-4 bg-dark">
    <div class="container-xl px-4 py-4">
        <p class="text-white-50 text-uppercase small mb-2">Reapify Network</p>
        <h1 class="text-white mb-3">From creator campaigns to recorded payments.</h1>
        <p class="lead text-white-50 mb-4" style="max-width: 45rem;">Manage clients, coordinate creators, review content performance and keep track of campaign payments in one place.</p>
        <a class="btn btn-primary me-2 mb-2" asp-controller="Campaigns" asp-action="Index">View campaigns</a>
        <a class="btn btn-outline-light mb-2" asp-controller="Creators" asp-action="Index">Browse creators</a>
    </div>
</header>

<div class="container-xl px-4 pb-4">
    <div class="row g-4 mb-5">
        <div class="col-md-6 col-xl-3">
            <section class="card h-100 shadow-sm"><div class="card-body d-flex flex-column">
                <h2 class="h5">Campaigns</h2>
                <p class="text-muted flex-grow-1">Set budgets, enroll creators and follow the results of each campaign.</p>
                <a asp-controller="Campaigns" asp-action="Index">Manage campaigns &rarr;</a>
            </div></section>
        </div>
        <div class="col-md-6 col-xl-3">
            <section class="card h-100 shadow-sm"><div class="card-body d-flex flex-column">
                <h2 class="h5">Creators</h2>
                <p class="text-muted flex-grow-1">Maintain creator profiles and find participants for your campaigns.</p>
                <a asp-controller="Creators" asp-action="Index">Explore creators &rarr;</a>
            </div></section>
        </div>
        <div class="col-md-6 col-xl-3">
            <section class="card h-100 shadow-sm"><div class="card-body d-flex flex-column">
                <h2 class="h5">Clients</h2>
                <p class="text-muted flex-grow-1">Keep business profiles and contact information organized.</p>
                <a asp-controller="Clients" asp-action="Index">View clients &rarr;</a>
            </div></section>
        </div>
        <div class="col-md-6 col-xl-3">
            <section class="card h-100 shadow-sm"><div class="card-body d-flex flex-column">
                <h2 class="h5">Transactions</h2>
                <p class="text-muted flex-grow-1">Review client deposits and creator payouts linked to campaign activity.</p>
                <a asp-controller="Transactions" asp-action="Index">Review transactions &rarr;</a>
            </div></section>
        </div>
    </div>

    <section class="card mb-4">
        <div class="card-body p-4">
            <h2 class="h4 mb-4">How a campaign moves forward</h2>
            <ol class="row g-4 list-unstyled mb-0">
                <li class="col-md-6 col-xl-3"><h3 class="h6">1. Plan and enroll</h3><p class="text-muted mb-0">Create a campaign for a client, define its budget and enroll creators.</p></li>
                <li class="col-md-6 col-xl-3"><h3 class="h6">2. Review content</h3><p class="text-muted mb-0">Add or import metrics, check the evidence and accept eligible submissions.</p></li>
                <li class="col-md-6 col-xl-3"><h3 class="h6">3. Calculate costs</h3><p class="text-muted mb-0">Calculate payments for complete blocks of 1,000 views within the campaign budget.</p></li>
                <li class="col-md-6 col-xl-3"><h3 class="h6">4. Record and settle</h3><p class="text-muted mb-0">Record the creator payout, then manually mark the metric as Settled.</p></li>
            </ol>
        </div>
    </section>
</div>
