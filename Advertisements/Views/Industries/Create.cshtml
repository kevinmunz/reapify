@model Advertisements.Models.IndustryModels.Industry

@{
    ViewData["Title"] = "Create industry";
}

<div class="container-fluid p-4 p-lg-5">
    <header class="mb-4"><a asp-controller="Industries" asp-action="Index" class="d-inline-block mb-3">&larr; Back to list</a><h1 class="h2">Create industry</h1><p class="text-muted">Organize clients by business sector.</p></header>
    <section class="card reapify-form-card"><div class="card-body p-4">
        @if (TempData["Error"] != null) { <div class="alert alert-danger" role="alert">@TempData["Error"]</div> }
        @if (TempData["Alert"] != null) { <div class="alert alert-warning" role="status">@TempData["Alert"]</div> }
        @if (TempData["Success"] != null) { <div class="alert alert-success" role="status">@TempData["Success"]</div> }
<form asp-action="Create" method="post">
                        <div asp-validation-summary="All" class="text-danger"></div>
                        <div class="mb-4">
                            <label asp-for="Name" class="form-label"></label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>
                        <hr class="my-4" />
                        <div class="d-flex justify-content-between">
                            <a class="btn btn-outline-primary" asp-controller="Industries" asp-action="Index">Cancel</a>
                            <button class="btn btn-primary" type="submit">Create</button>
                        </div>
                    </form>
    </div></section>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
