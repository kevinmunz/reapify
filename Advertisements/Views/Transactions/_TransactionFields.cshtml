@using Advertisements.Models.Enums
@model Advertisements.Models.TransactionModels.Transaction
<div class="row g-4">
    <div class="col-12">
        <label asp-for="Amount" class="form-label"></label>
        <input asp-for="Amount" class="form-control" />
        <span asp-validation-for="Amount" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Type" class="form-label">Transaction type</label>
        <select asp-for="Type" asp-items="Html.GetEnumSelectList<TranType>()" class="form-select"></select>
        <span asp-validation-for="Type" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Direction" class="form-label"></label>
        <select asp-for="Direction" asp-items="Html.GetEnumSelectList<Direction>()" class="form-select"></select>
        <span asp-validation-for="Direction" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="EntityId" class="form-label">Entity ID</label>
        <input asp-for="EntityId" class="form-control" readonly="@(ViewData["LockTransactionLinks"] as bool? == true)" />
        <span asp-validation-for="EntityId" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="ProductId" class="form-label">Campaign or metric ID</label>
        <input asp-for="ProductId" class="form-control" readonly="@(ViewData["LockTransactionLinks"] as bool? == true)" />
        <span asp-validation-for="ProductId" class="text-danger"></span>
    </div>
    <div class="col-12">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="3" maxlength="255"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
</div>
