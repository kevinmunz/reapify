@using Advertisements.Models.Enums
@model Advertisements.Models.MetricModels.Metric

@{
    ViewData["Title"] = "Record metric";
}

<div class="container-fluid p-4 p-lg-5">
    <header class="mb-4">
        <a asp-controller="Campaigns" asp-action="Index" class="d-inline-block mb-3">&larr; Campaigns</a>
        <h1 class="h2">Record metric</h1>
        <p class="text-muted">Add the content evidence and performance figures for this enrollment.</p>
    </header>
    <section class="card reapify-form-card"><div class="card-body p-4">
<form asp-action="Create" method="post" class="reapify-editor">
                        <div asp-validation-summary="All" class="text-danger"></div>
                        <div class="mb-4">
                            <label asp-for="SubmissionTimestamp" class="form-label"></label>
                            <input asp-for="SubmissionTimestamp" class="form-control" />
                            <span asp-validation-for="SubmissionTimestamp" class="text-danger"></span>
                        </div>
                        <div class="mb-4">
                            <label asp-for="CampaignCreatorId" class="form-label"></label>
                            <input asp-for="CampaignCreatorId" class="form-control" readonly />
                            <span asp-validation-for="CampaignCreatorId" class="text-danger"></span>
                        </div>
                        <div class="mb-4">
                            <label asp-for="ScreenshotLink" class="form-label"></label>
                            <input asp-for="ScreenshotLink" class="form-control" />
                            <span asp-validation-for="ScreenshotLink" class="text-danger"></span>
                        </div>
                        <div class="mb-4">
                            <label asp-for="VideoLink" class="form-label"></label>
                            <input asp-for="VideoLink" class="form-control" />
                            <span asp-validation-for="VideoLink" class="text-danger"></span>
                        </div>
                        <div class="mb-4">
                            <label asp-for="NumViews" class="form-label"></label>
                            <input asp-for="NumViews" class="form-control" />
                            <span asp-validation-for="NumViews" class="text-danger"></span>
                        </div>
                        <div class="mb-4">
                            <label asp-for="NumLikes" class="form-label"></label>
                            <input asp-for="NumLikes" class="form-control" />
                            <span asp-validation-for="NumLikes" class="text-danger"></span>
                        </div>
                        <div class="mb-4">
                            <label asp-for="NumComments" class="form-label"></label>
                            <input asp-for="NumComments" class="form-control" />
                            <span asp-validation-for="NumComments" class="text-danger"></span>
                        </div>
                        <div class="mb-4">
                            <label asp-for="NumShares" class="form-label"></label>
                            <input asp-for="NumShares" class="form-control" />
                            <span asp-validation-for="NumShares" class="text-danger"></span>
                        </div>
                        <div class="mb-4">
                            <label asp-for="NumSaves" class="form-label"></label>
                            <input asp-for="NumSaves" class="form-control" />
                            <span asp-validation-for="NumSaves" class="text-danger"></span>
                        </div>
                        <div class="mb-4">
                            <label asp-for="VideoDuration" class="form-label"></label>
                            <input asp-for="VideoDuration" class="form-control" />
                            <span asp-validation-for="VideoDuration" class="text-danger"></span>
                        </div>
                        <div class="mb-4">
                            <label asp-for="QRCodeLink" class="form-label"></label>
                            <input asp-for="QRCodeLink" class="form-control" />
                            <span asp-validation-for="QRCodeLink" class="text-danger"></span>
                        </div>
                        <div class="mb-4">
                            <label asp-for="CalculatedClientPayment" class="form-label"></label>
                            <div class="input-group">
                                <input asp-for="CalculatedClientPayment" class="form-control" />
                                <div class="input-group-text">BOB</div>
                            </div>
                            <span asp-validation-for="CalculatedClientPayment" class="text-danger"></span>
                        </div>
                        <div class="mb-4">
                            <label asp-for="CalculatedCreatorPayout" class="form-label"></label>
                            <div class="input-group">
                                <input asp-for="CalculatedCreatorPayout" class="form-control" />
                                <div class="input-group-text">BOB</div>
                            </div>
                            <span asp-validation-for="CalculatedCreatorPayout" class="text-danger"></span>
                        </div>
                        <hr class="my-4" />
                        <div class="d-flex justify-content-between">
                            <a class="btn btn-outline-primary" asp-controller="Metrics" asp-action="Index">Cancel</a>
                            <button class="btn btn-primary" type="submit">Create</button>
                        </div>
                    </form>
    </div></section>
</div>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}


