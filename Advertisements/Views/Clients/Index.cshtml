@model IEnumerable<Advertisements.Models.ClientModels.Client>

@{
    ViewData["Title"] = "Clients";
}

<div class="container-fluid p-4 p-lg-5">
    <header class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4"><div><p class="reapify-eyebrow">PEOPLE &amp; PARTICIPATION</p><h1 class="h2">Clients</h1></div><a class="btn btn-primary" asp-action="Create">Create new</a></header>
    @if (TempData["Success"] != null) { <div class="alert alert-success" role="status">@TempData["Success"]</div> }
    @if (TempData["Error"] != null) { <div class="alert alert-danger" role="alert">@TempData["Error"]</div> }
    <section class="card"><div class="card-body"><div class="table-responsive">
<table class="table table-hover align-middle" data-reapify-table>
                <thead>
                    <tr>
                        <th scope="col">Id</th>
                        <th scope="col">Date</th>
                        <th scope="col">Name</th>
                        <th scope="col">Country</th>
                        <th scope="col">State</th>
                        <th scope="col">Industry</th>
                        <th scope="col">Ref. Link</th>
                        <th scope="col">Contact</th>
                        <th scope="col">C. Email</th>
                        <th scope="col">C. Phone</th>
                        <th scope="col">NIT</th>
                        <th scope="col">Tax Address</th>                        
                        <th scope="col">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.EntityId)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.CreationDate)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Name)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.CountryName)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.StateName)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.IndustryName)
                            </td>
                            <td>
                                <a href="@item.ReferenceLink" target="_blank" rel="noopener noreferrer">REF Link</a>
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.ContactName)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.ContactEmail)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.ContactPhone)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.NIT)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.TaxAddress)
                            </td>
                            <td>
                                <a class="btn btn-outline-primary" asp-action="Update" asp-route-clientId="@item.EntityId">Edit</a>
                            </td>
                        </tr>
                    }

                </tbody>
            </table>
    </div></div></section>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/simple-datatables@7.1.2/dist/umd/simple-datatables.min.js" crossorigin="anonymous" asp-append-version="true"></script>
    <script src="~/js/reapify-tables.js" asp-append-version="true"></script>
}



